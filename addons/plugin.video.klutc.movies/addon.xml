<?xml version="1.0" encoding="UTF-8"?>
<addon id="plugin.video.klutc.movies" name="Klutc Movies" version="1.2.16" provider-name="Klutc">
  <requires>
    <import addon="xbmc.python" version="3.0.0" />
    <import addon="script.module.requests" version="1.1.0" />
    <import addon="script.module.beautifulsoup4" version="0.0.1" />
    <import addon="plugin.video.filmizip" version="1.3.20" />
    <import addon="plugin.video.filmi9" version="1.2.18" />
    <import addon="plugin.video.zenoplay" version="1.0.20" />
    <import addon="plugin.video.filmi2k" version="1.0.6" />
  </requires>
  <extension point="xbmc.python.pluginsource" library="default.py"><provides>video</provides></extension>
  <extension point="xbmc.addon.metadata">
    <summary lang="bg">Видео добавките на Klutc на едно място</summary>
    <description lang="bg">Отделно търсене на филми и сериали във FilmiZip, Filmi9, ZenoPlay и Filmi2K, както и достъп до каталога на всеки сайт.</description>
    <summary lang="en_GB">Klutc's video add-ons in one place</summary>
    <description lang="en_GB">Search movies or series across FilmiZip, Filmi9, ZenoPlay and Filmi2K, or open each site catalogue separately.</description>
    <platform>all</platform>
    <license>MIT</license>
    <language>bg</language>
    <assets><icon>resources/icon.png</icon></assets>
  </extension>
</addon>
