<?xml version="1.0" encoding="UTF-8"?>
<settings version="1">
  <section id="plugin.video.zenoplay">
    <category id="playback" label="Възпроизвеждане">
      <group id="1">
        <setting id="voe_mp4" type="boolean" label="VOE: директен MP4 поток на Android" help="Използва MP4 вместо HLS на Android TV, когато хостът го предоставя. Изключете за HLS.">
          <level>0</level>
          <default>true</default>
          <control type="toggle" />
        </setting>
      </group>
    </category>
    <category id="metadata" label="Информация за филмите">
      <group id="1">
        <setting id="tmdb_read_token" type="string" label="TMDb API Read Access Token" help="Нужен е за актьорския състав в ZenoPlay. Заявките се кешират за 7 дни.">
          <level>0</level>
          <default></default>
          <constraints><allowempty>true</allowempty></constraints>
          <control type="edit" format="string"><heading>TMDb API Read Access Token</heading><hidden>true</hidden></control>
        </setting>
      </group>
    </category>
  </section>
</settings>
